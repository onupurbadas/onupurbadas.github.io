<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable project-card" style="background-image: url('{{ project.img | relative_url }}'); background-size: cover; background-position: center;">
      <div class="project-card-overlay">
        <h3>{{ project.title }}</h3>
        <p>{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>